# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autoComposeDB?retryWrites=true&w=majority

# NVIDIA NIM
NVIDIA_API_KEY=<your-nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
CRON_SECRET=<generate-with: openssl rand -hex 32>
SCHEDULE_BACKGROUND_WORKER=true
SCHEDULE_WORKER_INTERVAL_MS=60000
SCHEDULE_WORKER_MAX_SCHEDULES=5
SCHEDULE_WORKER_MAX_EMAILS_PER_SCHEDULE=10

# Auth.js
AUTH_SECRET=<generate-with: openssl rand -base64 32>
AUTH_URL=http://localhost:3000

# Telegram Bot (optional; integration disabled when unset)
TELEGRAM_BOT_TOKEN=<your-bot-token-from-botfather>
TELEGRAM_BOT_USERNAME=<your-bot-username-without-@>
TELEGRAM_WEBHOOK_SECRET=<generate-with: openssl rand -hex 32>
